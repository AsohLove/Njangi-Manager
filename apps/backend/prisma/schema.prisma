generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CycleStatus {
  active
  complete
}

enum SelectionMethod {
  auto
  app_draw
  manual_draw
}

enum RoundStatus {
  open
  closed
}

enum FineStatus {
  owed
  paid
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name") @db.VarChar(120)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  groups Group[]

  @@map("users")
}

model Group {
  id        Int      @id @default(autoincrement())
  ownerId   Int      @map("owner_id")
  name      String   @db.VarChar(120)
  amount    Int
  frequency String   @db.VarChar(10)
  startDate DateTime @map("start_date") @db.Date
  orderMode String   @map("order_mode") @db.VarChar(10)
  shareCode String   @unique @map("share_code") @db.VarChar(24)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  owner         User           @relation(fields: [ownerId], references: [id])
  members       Member[]
  positions     Position[]
  cycles        Cycle[]
  fineRules     FineRule[]
  fundSpendings FundSpending[]
  adjustments   Adjustment[]
  fines         Fine[]

  @@map("groups")
}

model Member {
  id       Int     @id @default(autoincrement())
  groupId  Int     @map("group_id")
  fullName String  @map("full_name") @db.VarChar(120)
  phone    String? @db.VarChar(30)

  group       Group        @relation(fields: [groupId], references: [id])
  positions   Position[]
  fines       Fine[]
  adjustments Adjustment[]

  @@map("members")
}

model Position {
  id            Int     @id @default(autoincrement())
  groupId       Int     @map("group_id")
  memberId      Int     @map("member_id")
  rotationOrder Int?    @map("rotation_order")
  isActive      Boolean @default(true) @map("is_active")

  group           Group     @relation(fields: [groupId], references: [id])
  member          Member    @relation(fields: [memberId], references: [id])
  collectorRounds Round[]   @relation("RoundCollector")
  payments        Payment[]
  payout          Payout[]

  @@unique([groupId, rotationOrder])
  @@map("positions")
}

model Cycle {
  id          Int         @id @default(autoincrement())
  groupId     Int         @map("group_id")
  number      Int
  status      CycleStatus @default(active)
  startedAt   DateTime    @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt DateTime?   @map("completed_at") @db.Timestamptz(3)

  group  Group   @relation(fields: [groupId], references: [id])
  rounds Round[]

  @@unique([groupId, number])
  @@map("cycles")
}

model Round {
  id                  Int             @id @default(autoincrement())
  cycleId             Int             @map("cycle_id")
  number              Int
  collectorPositionId Int             @map("collector_position_id")
  selectionMethod     SelectionMethod @map("selection_method")
  eligiblePositionIds Json?           @map("eligible_position_ids")
  dueDate             DateTime        @map("due_date") @db.Date
  status              RoundStatus     @default(open)
  openedAt            DateTime        @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt            DateTime?       @map("closed_at") @db.Timestamptz(3)

  cycle             Cycle        @relation(fields: [cycleId], references: [id])
  collectorPosition Position     @relation("RoundCollector", fields: [collectorPositionId], references: [id])
  payments          Payment[]
  fines             Fine[]
  payout            Payout?
  adjustments       Adjustment[]

  @@unique([cycleId, number])
  @@map("rounds")
}

model Payment {
  id         Int      @id @default(autoincrement())
  roundId    Int      @map("round_id")
  positionId Int      @map("position_id")
  amount     Int
  isLate     Boolean  @default(false) @map("is_late")
  paidAt     DateTime @default(now()) @map("paid_at") @db.Timestamptz(3)

  round    Round    @relation(fields: [roundId], references: [id])
  position Position @relation(fields: [positionId], references: [id])

  @@unique([roundId, positionId])
  @@map("payments")
}

model Fine {
  id        Int        @id @default(autoincrement())
  groupId   Int        @map("group_id")
  ruleId    Int        @map("rule_id")
  roundId   Int?       @map("round_id")
  memberId  Int        @map("member_id")
  amount    Int
  note      String?
  status    FineStatus @default(owed)
  appliedAt DateTime   @default(now()) @map("applied_at") @db.Timestamptz(3)
  paidAt    DateTime?  @map("paid_at") @db.Timestamptz(3)

  group  Group    @relation(fields: [groupId], references: [id])
  rule   FineRule @relation(fields: [ruleId], references: [id])
  round  Round?   @relation(fields: [roundId], references: [id])
  member Member   @relation(fields: [memberId], references: [id])

  @@map("fines")
}

model Payout {
  id         Int      @id @default(autoincrement())
  roundId    Int      @unique @map("round_id")
  positionId Int      @map("position_id")
  amount     Int
  shortfall  Int      @default(0)
  paidAt     DateTime @default(now()) @map("paid_at") @db.Timestamptz(3)

  round    Round    @relation(fields: [roundId], references: [id])
  position Position @relation(fields: [positionId], references: [id])

  @@map("payouts")
}

model FineRule {
  id            Int    @id @default(autoincrement())
  groupId       Int    @map("group_id")
  name          String @db.VarChar(80)
  defaultAmount Int    @map("default_amount")

  group Group  @relation(fields: [groupId], references: [id])
  fines Fine[]

  @@map("fine_rules")
}

model FundSpending {
  id      Int      @id @default(autoincrement())
  groupId Int      @map("group_id")
  amount  Int
  note    String
  spentAt DateTime @default(now()) @map("spent_at") @db.Timestamptz(3)

  group Group @relation(fields: [groupId], references: [id])

  @@map("fund_spending")
}

model Adjustment {
  id          Int      @id @default(autoincrement())
  groupId     Int      @map("group_id")
  memberId    Int?     @map("member_id")
  roundId     Int?     @map("round_id")
  amount      Int
  affectsFund Boolean  @default(false) @map("affects_fund")
  note        String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  group  Group   @relation(fields: [groupId], references: [id])
  member Member? @relation(fields: [memberId], references: [id])
  round  Round?  @relation(fields: [roundId], references: [id])

  @@map("adjustments")
}
